{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/index.html"
    },
    {
      "source": "/condiciones",
      "destination": "/index.html"
    },
    {
      "source": "/aviso-legal",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tehagohueco.vercel.app"
        }
      ],
      "destination": "https://www.tehagohueco.es/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blablahelp.vercel.app"
        }
      ],
      "destination": "https://www.tehagohueco.es/:path*",
      "permanent": true
    }
  ]
}